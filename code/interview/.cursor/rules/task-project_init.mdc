### services/event.dart

```dart
part of 'services.dart';

class EventService extends GetxService {
  // 事件总线实现
  final _eventBus = <String, List<Function>>{};

  void on(String event, Function callback) {
    _eventBus[event] ??= [];
    _eventBus[event]!.add(callback);
  }

  void off(String event, [Function? callback]) {
    if (callback == null) {
      _eventBus.remove(event);
    } else {
      _eventBus[event]?.remove(callback);
    }
  }

  void emit(String event, [dynamic data]) {
    _eventBus[event]?.forEach((callback) => callback(data));
  }
}
```


### routes/observers.dart

```dart
part of 'index.dart';

class RouteObservers extends RouteObserver<Route> {
  @override
  void didPush(Route route, Route? previousRoute) {
    super.didPush(route, previousRoute);
    if (route.settings.name != null) {
      CustomRouter.history.add(route.settings.name!);
    }
  }

  @override
  void didPop(Route route, Route? previousRoute) {
    super.didPop(route, previousRoute);
    if (CustomRouter.history.isNotEmpty) {
      CustomRouter.history.removeLast();
    }
  }
}
```

## 4. global.dart 模板

```dart
import 'dart:io';
import 'package:get/get.dart';
import 'package:package_info_plus/package_info_plus.dart';
import 'package:your_project/services/index.dart';
import 'package:your_project/store/index.dart';

class Global {
  static final Global _instance = Global._internal();

  factory Global() => _instance;

  Global._internal();

  PackageInfo? _platform;

  static String channel = 'official';
  static bool get isDesktop =>
      Platform.isWindows || Platform.isLinux || Platform.isMacOS;

  static String get version => _instance._platform?.version ?? '0.0.0';

  static String get build => _instance._platform?.buildNumber ?? '0';

  static String get appName => _instance._platform?.appName ?? '-';

  static Future<void> init() async {
    await Future.wait([
      _instance._initPlatform(),
      Get.putAsync<StorageService>(() => StorageService().init()),
    ]).whenComplete(() {
      Get.put<EventService>(EventService());
      Get.put<HttpService>(HttpService());
      Get.put<ConfigStore>(ConfigStore());
      Get.put<UserStore>(UserStore());
    });
  }

  Future<void> _initPlatform() async {
    _platform = await PackageInfo.fromPlatform();
  }
}

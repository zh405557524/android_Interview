## 1. main.dart 模板

```dart
import 'package:flutter/foundation.dart';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:flutter_localizations/flutter_localizations.dart';
import 'package:flutter_screenutil/flutter_screenutil.dart';
import 'package:your_project/global.dart';
import 'package:your_project/routes/index.dart';
import 'package:your_project/theme.dart';
import 'package:your_project/widgets/index.dart';

void main() async {
  final widgetsBinding = WidgetsFlutterBinding.ensureInitialized();

  // 设置系统UI样式
  SystemChrome.setSystemUIOverlayStyle(CustomTheme.systemStyleLight);

  // 添加超时机制，确保初始化不会无限等待
  bool initCompleted = false;

  // 启动定时器，确保5秒后无论如何都继续执行
  Future.delayed(const Duration(seconds: 5), () {
    if (!initCompleted) {
      // 如果初始化未完成，强制继续（可根据需要添加日志或错误处理）
    }
  });

  try {
    await Global.init();
  } catch (e) {
    // 初始化失败时的错误处理
    // 可以根据需要添加错误恢复逻辑，如清除缓存等
    try {
      // 示例：清除本地存储（根据实际需求调整）
      // final prefs = await SharedPreferences.getInstance();
      // await prefs.clear();
      await Global.init();
    } catch (e) {
      // 如果再次失败，记录错误或使用默认配置
    }
  }

  initCompleted = true;
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp.router(
      title: '应用名称',
      theme: CustomTheme.light,
      themeMode: ThemeMode.light,
      localizationsDelegates: const [
        GlobalMaterialLocalizations.delegate,
        GlobalCupertinoLocalizations.delegate,
        GlobalWidgetsLocalizations.delegate,
      ],
      supportedLocales: const [
        Locale.fromSubtags(languageCode: 'en'),
        Locale.fromSubtags(languageCode: 'zh'),
      ],
      locale: WidgetsBinding.instance.platformDispatcher.locale,
      routerConfig: CustomRouter.config,
      builder: (context, child) {
        return MediaQuery(
          data: MediaQuery.of(context),
          child: Builder(
            builder: (innerContext) {
              // 使用 innerContext 初始化 ScreenUtil
              ScreenUtil.init(
                innerContext,
                designSize: const Size(375, 812),
                minTextAdapt: true,
                splitScreenMode: true,
              );

              return CustomToast.init(
                context: innerContext,
                builder: (context, child) => MediaQuery(
                  data: MediaQuery.of(context).copyWith(
                    textScaler: TextScaler.noScaling,
                  ),
                  child: child ?? const Material(),
                ),
              )(innerContext, child);
            },
          ),
        );
      },
    );
  }
}
```

### 说明

**保留的核心功能：**
- ✅ 屏幕适配（ScreenUtil） - 使用 `designSize: Size(375, 812)` 作为移动端标准尺寸
- ✅ 主题配置（CustomTheme） - 使用 `CustomTheme.light` 和 `systemStyleLight`
- ✅ 国际化支持（Flutter Localizations） - 支持英文和中文
- ✅ 路由配置（GoRouter） - 使用 `CustomRouter.config`
- ✅ Toast初始化（CustomToast） - 支持全局提示
- ✅ 错误处理机制 - 初始化失败时的恢复逻辑
- ✅ 超时保护 - 防止初始化无限等待

**去除的业务相关代码：**
- ❌ Umeng APM SDK（性能监控）
- ❌ 启动屏幕（FlutterNativeSplash）
- ❌ 微信SDK相关
- ❌ 桌面端判断和窗口管理
- ❌ 其他第三方业务SDK

**可选的扩展功能：**
如果需要启动屏幕，可以添加：
```dart
import 'package:flutter_native_splash/flutter_native_splash.dart';

// 在 main 函数中
FlutterNativeSplash.preserve(widgetsBinding: widgetsBinding);
// 初始化完成后
FlutterNativeSplash.remove();
```

## 2. theme.dart 模板

```dart
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';

abstract class CustomTheme {
  // 基础间距
  static const margin = 16.0;
  static const padding = 16.0;

  // 主题颜色
  static const primary = Color(0xFF5497FF);
  static const success = Color(0xFF0ED529);
  static const warning = Color(0xFFFFD575);
  static const error = Color(0xFFFF5F5F);
  static const info = Color(0xFF309BFF);

  // 背景色
  static const mainBackground = Color(0xFFF6F9FF);
  static const cardBackground = Color(0xFFFFFFFF);

  // 文字颜色
  static const textPrimary = Color(0xFF333333);
  static const textSecondary = Color(0xFF666666);
  static const textTertiary = Color(0xFF999999);

  // 分割线颜色
  static const dividerColor = Color(0xFFD8D8D8);
  static const borderColor = Color(0xFFE0E0E0);

  // 系统UI样式
  static ThemeMode mode = ThemeMode.light;

  static SystemUiOverlayStyle get systemStyle => const SystemUiOverlayStyle(
        statusBarColor: Colors.transparent,
        statusBarBrightness: Brightness.light,
        statusBarIconBrightness: Brightness.dark,
        systemNavigationBarDividerColor: Colors.transparent,
        systemNavigationBarColor: Colors.white,
        systemNavigationBarIconBrightness: Brightness.dark,
      );

  static SystemUiOverlayStyle get systemStyleLight => systemStyle.copyWith(
        statusBarBrightness: Brightness.light,
        statusBarIconBrightness: Brightness.dark,
        systemNavigationBarIconBrightness: Brightness.dark,
      );

  static SystemUiOverlayStyle get systemStyleDark => systemStyle.copyWith(
        statusBarBrightness: Brightness.dark,
        statusBarIconBrightness: Brightness.light,
        systemNavigationBarColor: const Color(0xFF0D0D0D),
        systemNavigationBarIconBrightness: Brightness.light,
      );

  // 亮色主题
  static ThemeData get light {
    const scheme = ColorScheme.light(
      surface: Color(0xFFF6F9FF),
      onSurface: Color(0xFF333333),
      surfaceContainer: Color(0xFFFFFFFF),
      onSurfaceVariant: Color(0xFF999999),
      primary: primary,
      onPrimary: Colors.white,
      secondary: Color(0xFF666666),
      onSecondary: Color(0xFF999999),
      outline: Color(0xFFD8D8D8),
      outlineVariant: Color(0xFFE0E0E0),
      error: error,
      onError: Colors.white,
    );

    return _getTheme(scheme);
  }

  // 暗色主题
  static ThemeData get dark {
    const scheme = ColorScheme.dark(
      surface: Color(0xFF111113),
      onSurface: Colors.white,
      surfaceContainer: Color(0xFF1B1B1C),
      primary: primary,
      onPrimary: Colors.white,
      secondary: Color(0xFF999999),
      onSecondary: Color(0xFF666666),
      outline: Color(0xFF333333),
      error: error,
      onError: Colors.white,
    );
    return _getTheme(scheme);
  }

  static ThemeData _getTheme(ColorScheme scheme) {
    return ThemeData(
      colorScheme: scheme,
      scaffoldBackgroundColor: scheme.surface,
      splashColor: Colors.transparent,
      highlightColor: Colors.transparent,
      textSelectionTheme: const TextSelectionThemeData(
        selectionColor: Color(0xFF25C1FF),
        selectionHandleColor: Color(0xFF25C1FF),
        cursorColor: Color(0xFF25C1FF),
      ),
      textTheme: TextTheme(
        bodyMedium: TextStyle(
          fontSize: 16,
          color: scheme.onSurface,
          height: 1.2,
        ),
      ),
      dividerTheme: DividerThemeData(
        color: scheme.outline,
        thickness: 1,
        space: 1,
      ),
      appBarTheme: AppBarTheme(
        foregroundColor: scheme.onSurface,
        backgroundColor: scheme.surface,
        surfaceTintColor: Colors.transparent,
        scrolledUnderElevation: 0,
        elevation: 0,
        centerTitle: true,
        toolbarHeight: 44,
        titleTextStyle: TextStyle(
          fontSize: 18,
          fontWeight: FontWeight.bold,
          color: scheme.onSurface,
        ),
      ),
      elevatedButtonTheme: const ElevatedButtonThemeData(
        style: ButtonStyle(
          minimumSize: WidgetStatePropertyAll(Size.zero),
          maximumSize: WidgetStatePropertyAll(Size.infinite),
          tapTargetSize: MaterialTapTargetSize.shrinkWrap,
          splashFactory: NoSplash.splashFactory,
          elevation: WidgetStatePropertyAll(0),
        ),
      ),
    );
  }
}
```


```dart
import 'package:flutter/foundation.dart';

/// 日志打印帮助类
///
/// 提供统一的日志打印接口，支持不同级别的日志输出
/// 在 debug 模式下会打印日志，release 模式下不会打印
class Logger {
  /// 日志级别枚举
  static const int _levelDebug = 0;
  static const int _levelInfo = 1;
  static const int _levelWarning = 2;
  static const int _levelError = 3;

  /// 当前日志级别（默认只显示 info 及以上级别）
  static int _currentLevel = _levelDebug;

  /// 是否启用日志（默认在 debug 模式下启用）
  static bool _enabled = kDebugMode;

  /// 设置日志级别
  ///
  /// [level] 日志级别：0=debug, 1=info, 2=warning, 3=error
  static void setLevel(int level) {
    _currentLevel = level;
  }

  /// 启用/禁用日志
  static void setEnabled(bool enabled) {
    _enabled = enabled;
  }

  /// 打印 Debug 级别日志
  ///
  /// [message] 日志消息
  /// [tag] 日志标签，用于分类
  /// [error] 错误对象（可选）
  /// [stackTrace] 堆栈跟踪（可选）
  static void debug(
    dynamic message, {
    String? tag,
    Object? error,
    StackTrace? stackTrace,
  }) {
    _log(_levelDebug, message, tag: tag, error: error, stackTrace: stackTrace);
  }

  /// 打印 Info 级别日志
  ///
  /// [message] 日志消息
  /// [tag] 日志标签，用于分类
  /// [error] 错误对象（可选）
  /// [stackTrace] 堆栈跟踪（可选）
  static void info(
    dynamic message, {
    String? tag,
    Object? error,
    StackTrace? stackTrace,
  }) {
    _log(_levelInfo, message, tag: tag, error: error, stackTrace: stackTrace);
  }

  /// 打印 Warning 级别日志
  ///
  /// [message] 日志消息
  /// [tag] 日志标签，用于分类
  /// [error] 错误对象（可选）
  /// [stackTrace] 堆栈跟踪（可选）
  static void warning(
    dynamic message, {
    String? tag,
    Object? error,
    StackTrace? stackTrace,
  }) {
    _log(_levelWarning, message, tag: tag, error: error, stackTrace: stackTrace);
  }

  /// 打印 Error 级别日志
  ///
  /// [message] 日志消息
  /// [tag] 日志标签，用于分类
  /// [error] 错误对象（可选）
  /// [stackTrace] 堆栈跟踪（可选）
  static void error(
    dynamic message, {
    String? tag,
    Object? error,
    StackTrace? stackTrace,
  }) {
    _log(_levelError, message, tag: tag, error: error, stackTrace: stackTrace);
  }

  /// 内部日志打印方法
  static void _log(
    int level,
    dynamic message, {
    String? tag,
    Object? error,
    StackTrace? stackTrace,
  }) {
    if (!_enabled || level < _currentLevel) {
      return;
    }

    final levelName = _getLevelName(level);
    final timestamp = DateTime.now().toString().substring(11, 19);
    final tagStr = tag != null ? '[$tag]' : '';
    final prefix = '[$timestamp] [$levelName]$tagStr';

    if (error != null) {
      debugPrint('$prefix $message');
      debugPrint('Error: $error');
      if (stackTrace != null) {
        debugPrint('StackTrace: $stackTrace');
      }
    } else {
      debugPrint('$prefix $message');
    }
  }

  /// 获取日志级别名称
  static String _getLevelName(int level) {
    switch (level) {
      case _levelDebug:
        return 'DEBUG';
      case _levelInfo:
        return 'INFO';
      case _levelWarning:
        return 'WARNING';
      case _levelError:
        return 'ERROR';
      default:
        return 'UNKNOWN';
    }
  }

  /// 打印对象（用于调试）
  ///
  /// [obj] 要打印的对象
  /// [tag] 日志标签
  static void printObject(dynamic obj, {String? tag}) {
    if (!_enabled) return;
    final tagStr = tag != null ? '[$tag]' : '';
    debugPrint('$tagStr ${obj.toString()}');
  }

  /// 打印 JSON 数据（格式化输出）
  ///
  /// [json] JSON 数据
  /// [tag] 日志标签
  static void printJson(dynamic json, {String? tag}) {
    if (!_enabled) return;
    final tagStr = tag != null ? '[$tag]' : '';
    try {
      // 简单的 JSON 格式化（如果需要更复杂的格式化，可以使用 dart:convert）
      debugPrint('$tagStr JSON: $json');
    } catch (e) {
      debugPrint('$tagStr Failed to print JSON: $e');
    }
  }
}
```

**使用示例：**

```dart
import 'package:your_project/utils/index.dart';

// 基本使用
Logger.debug('这是一条调试信息', tag: 'UserService');
Logger.info('用户登录成功', tag: 'Auth');
Logger.warning('网络请求超时', tag: 'HttpService');
Logger.error('登录失败', tag: 'Auth', error: exception);

// 打印对象
Logger.printObject(userData, tag: 'UserData');

// 打印 JSON
Logger.printJson(responseData, tag: 'API Response');

// 配置日志级别（只显示 warning 及以上）
Logger.setLevel(Logger._levelWarning);

// 禁用日志（release 模式下自动禁用）
Logger.setEnabled(false);
```

**注意事项：**
- 默认只在 debug 模式下启用日志，release 模式下自动禁用
- 支持不同级别的日志：debug、info、warning、error
- 可以通过 `setLevel()` 设置日志级别，过滤低级别日志
- 支持标签分类，方便在大量日志中快速定位
- 支持错误对象和堆栈跟踪打印
- 使用 `debugPrint` 而不是 `print`，避免在 release 模式下输出

